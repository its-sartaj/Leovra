    {
      "@type": "FAQPage",
      "@id": "https://loevraenterprises.publicvm.com/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is Cash on Delivery (COD) available on Leovra Enterprises?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, Cash on Delivery (COD) is available on all products across India. You can also pay via UPI (GPay, PhonePe, Paytm) for instant confirmation."
          }
        },
        {
          "@type": "Question",
          "name": "What is the return policy for Leovra Enterprises?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Leovra offers a 3-day return window from the date of delivery for defective, damaged, or wrong products received. Correctly delivered items in good condition are not eligible for return."
          }
        },
        {
          "@type": "Question",
          "name": "How long does delivery take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Orders are dispatched via Shiprocket Express courier partners (Delhivery, Blue Dart, Shadowfax) within 24-48 hours. Delivery usually takes 2-5 business days depending on your pincode."
          }
        },
        {
          "@type": "Question",
          "name": "How can I track my Leovra order?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can track your order directly in the 'My Orders' tab of your account or reach out to our customer support on WhatsApp with your Order ID for real-time Shiprocket AWB updates."
          }
        },
        {
          "@type": "Question",
          "name": "What product categories does Leovra Enterprises specialize in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Leovra Enterprises specializes in handcrafted artisanal jewellery (Kundan, oxidized silver jhumkas, meenakari chandbalis), heavyweight graphic streetwear t-shirts (240+ GSM combed Supima cotton), and high-comfort men's 4-way stretch gym trackpants & tactical cargo joggers."
          }
        },
        {
          "@type": "Question",
          "name": "How to order products on WhatsApp from Leovra Enterprises?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You can order directly on our website or tap 'Order on WhatsApp' on any product page. This sends your chosen item, size, and address directly to our WhatsApp support helpline (+91 7979968347) for immediate order dispatch with Cash on Delivery."
          }
        }
      ]
